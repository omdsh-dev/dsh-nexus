// ===========================================================================
// 渠道
// ===========================================================================

/// 一个渠道：Github、Gitlab、飞书、QQ、微信 Claw。
/// 它既是「事件从哪来」，也是「回复往哪发」。
/// 渠道的监听开关也记在这里，对应概览页的「监听渠道 (2/4)」。
///
/// 注意：这里**没有**提示词字段。渠道的用法说明是 `assets/skills/nexus-channel-<id>/SKILL.md`，
/// 一个 Markdown 文件，和官方 `skills/dsh-superagent-<name>/SKILL.md` 同一套形式。
/// 说明书归仓库（跟着代码评审、跟着版本走），运行状态归数据库，两边不混。
model Channel {
  /// 'github' | 'gitlab' | 'feishu' | 'qq' | 'wechat'
  /// 故意保持 String：这是身份而非状态，新增渠道只要插一行，不该逼一次迁移。
  ///
  /// **它同时决定用哪份 skill**：`nexus-channel-<id>`，
  /// 例如 `github` → `assets/skills/nexus-channel-github/SKILL.md`。
  /// 一个渠道一份 skill，不搞别名。
  id      String  @id
  /// 展示名
  name    String
  /// 是否开启监听；关掉的渠道不会再产生触发
  enabled Boolean @default(false)

  /// 自建 GitLab 的站点地址。仅 gitlab 使用，SaaS 留空即 `gitlab.com`。
  host String?

  createdAt String

  accounts ChannelAccount[]
  projects Project[]
  threads  Thread[]
  triggers Trigger[]
  tickets  Ticket[]
  ciWatch  CiWatch[]
  states   SourceState[]

  @@map("channel")
}

/// 渠道里的一个账号，对应渠道页的「机器人账号（谁去执行）」与「管理员账号（谁去派活）」。
model ChannelAccount {
  id        String        @id
  channelId String
  role      AccountRole
  /// 渠道侧的显示名，例如 GitHub 登录名、飞书用户名
  name      String
  avatar    String?
  status    AccountStatus @default(offline)
  createdAt String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// 同一个渠道里同类账号不重名
  @@unique([channelId, role, name])
  @@index([channelId, role])
  @@map("channel_account")
}

/// 一个 CI 观察点。**每个被观察的目标一行**，用来算「这次和上次比变了吗」。
///
/// 官方把这份状态存在 KV 里，键是 `github.branchCi` 和 `github.ci(<PR 号>)`。
/// 我们建表，因为它是真正的业务状态：判断要不要产生触发全靠它。
///
/// 为什么必须有这张表：CI 一次运行会产生几十次状态变化，每次都发触发会把收件箱刷满。
/// 所以只有「和上一次比变不同了」才发。没有这份记忆，就没法比。
model CiWatch {
  id String @id

  /// 观察点在哪条渠道
  channelId String

  /// 观察目标：
  ///   'branch' 默认分支。ref 是分支名，例如 `main`
  ///   'pull'   某张 PR 的 head。ref 是 PR 号
  kind String

  /// 'branch' 时是分支名，'pull' 时是 PR 号
  ref String

  /// 观察目标的当前指纹。
  ///   'branch'：失败 check 名的排序 JSON，例如 `["lint","test"]`
  ///   'pull'  ：整份快照的哈希
  /// 和它相等就说明没变，不发触发
  fingerprint String

  /// 发过几次触发。每次变化 +1，进触发 id 保证重复轮询得到同一个 id
  revision Int @default(0)

  /// 'branch' 专用：上一次看到的 head sha。
  /// 分支换了提交但 CI 结果恰好一样时，靠它区分「仍是旧结论」还是「新一轮」
  head String?

  updatedAt String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, kind, ref])
  @@map("ci_watch")
}

/// 账号在渠道里扮演的角色。
enum AccountRole {
  /// 机器人：在渠道里替我们说话、执行动作
  bot
  /// 管理员：允许给我们派活的人，属于准入名单
  admin
}

/// 账号的登录状态。
enum AccountStatus {
  /// 已登录，可以收发
  online
  /// 未登录；这个渠道不会产生触发，也发不出去
  offline
}

/// 一个渠道读到哪了。**每个需要增量读取的目标一行。**
///
/// 为什么入库：进程重启后如果不知道读到哪，只能从头重读整个历史。
/// 触发 id 由来源事实派生，重复读不会产生重复数据 —— 但会把 API 配额烧光，
/// 而且首轮会卡很久。
///
/// 这是**运行状态**，不是配置，所以不进 `setting.prisma`。
model SourceState {
  /// 渠道 id，见 `Channel.id`
  channelId String
  /// 游标名。各渠道自己定，例如：
  ///   `notifications`  通知列表的 since
  ///   `thread:42`      issue / MR 42 的评论游标
  ///   `thread:ci:main` 分支 CI 的观察位置
  ///   `feishu:oc_xxx`  飞书某个会话的读取位置
  name      String

  /// 游标值。JSON 字符串，形状归各渠道自己解释
  value String

  /// 最后一次推进的时间，用来发现「这个游标停了多久」
  updatedAt String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, name])
  @@index([updatedAt])
  @@map("source_state")
}
