// ===========================================================================
// Worker（执行会话）
// ===========================================================================

/// 一个 Worker（执行会话）：任务在某个 DSH 会话里真正干活的那一段。
/// 一个任务可以先后有好几个（重试、换人），对应详情页的「执行会话 (1~5) 个」。
/// 官方把这件事叫 Assignment，字段多得多；我们只留最有用的几个。
///
/// **一个 Worker 只对应一个 worktree**，所以分支和路径直接放在这一行上，
/// 不再单开一张「会话挂了哪些仓库」的表。跨项目协作靠 Supervisor，
/// 不靠一个会话改多个仓库。
model Worker {
  /// DSH 会话 id，直接就是主键
  id          String           @id
  ticketId    String
  status      WorkerStatus
  createdAt   String
  /// 会话真正开始跑的时间
  startedAt   String?
  endedAt     String?
  /// 会话标题。面板上显示的名字，编排可以用 rename 改，方便人一眼看懂它在干嘛
  title       String?
  endedReason WorkerEndReason?

  /// 它独占的那个 worktree：分支名 + 绝对路径。
  /// 还没建 worktree（status = queued）时这两个为空
  branch   String?
  worktree String?

  /// 最近一次汇报：状态 + 一句话摘要，详情页直接显示。
  /// 和会话正文是两条通道 —— 这里只有状态，正文靠 view 读
  reportState ReportState?
  report      String?
  reportAt    String?

  // ── 槽位与恢复 ──────────────────────────────────────────────────────────

  /// 后台工作还能跑到什么时候。
  ///
  /// 回合结束时如果还有 shell job 或 subagent 在跑，**票继续占着槽位、继续算
  /// working**，不报 waiting —— 否则槽位被别的票占了，任务起了服务器却没人接。
  /// 上限 30 分钟；到点杀掉后台并把票报成 waiting。
  /// 为空表示没有后台工作，正常释放槽位。
  backgroundUntil String?

  /// 被重启打断后重开时写的一句话：
  /// 「先查目录、git 历史和 GitHub，再决定要不要重做外部动作」。
  ///
  /// 没有它，重启后的 Worker 不知道自己在哪，会重复开 PR、重复发评论。
  recoveryNote String?

  ticket Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// 这个会话冒出来的消息（开工、汇报、失败）
  inbox  Inbox[]

  @@index([ticketId, createdAt])
  @@index([status])
  @@map("worker")
}

/// Worker 会话本身的存活状态。
enum WorkerStatus {
  /// 排队中：已登记，会话还没真正起来
  queued
  /// 运行中
  running
  /// 已结束
  ended
}

/// Worker 是怎么结束的；还开着时为空。
enum WorkerEndReason {
  /// 正常结束
  completed
  /// 被停
  stopped
  /// 失败
  failed
  /// 宿主重启打断
  restarted
}

/// 一次汇报的状态。
///
/// `report` 只讲事实、不等答复；「我在等一个答案」归 `ask`，不占状态位。
enum ReportState {
  /// 还在跑，阶段性推进
  progress
  /// 干完了，PR 已开，可以审
  ready
  /// 失败了，需要重试或人介入
  failed
  /// 不用做了：复现不了、已被别人修了、需求被取代。
  /// 票直接结束，默认不对外发消息 —— 这是「什么都不做」的合法表达，
  /// 没有它，Worker 遇到这种活只能谎报 ready 或者白问一次人
  dropped
}
