// ===========================================================================
// 设置
// ===========================================================================

/// 全局设置。**只有一行**，`id` 固定为 `global`。
///
/// 所有配置类的东西都放这里，不要散到 Project / Channel / Worker 上。
/// 理由：配置是「这套系统怎么跑」，属于部署；项目是「哪个仓库」，属于业务。
/// 混在一起的结果是改一条并发上限要去翻每个项目的记录。
///
/// 运行期的状态不在这里 —— 那些属于各自的行（例如 `Ticket.paused`、
/// `Worker.backgroundUntil`、`Channel.enabled`）。
model Setting {
  /// 固定 `global`
  id String @id

  // ── 并发 ──────────────────────────────────────────────────────────────

  /// 同时能跑几个 Worker（槽位上限）。超出就排队 `queued`。范围 1–16。
  ///
  /// **额外留 1 个槽位给「人的消息」和状态查询**：正常槽位满时仍能插进去，
  /// 所以新人派活永远挤不掉你已经在做的活。
  maxWorkers Int @default(4)

  /// 后台工作最多还能跑几分钟。到点杀掉后台、把票报成 waiting。
  ///
  /// 回合结束时如果还有 shell job 或 subagent 在跑，票继续占着槽位、继续算
  /// working，不报 waiting —— 否则槽位被别的票占了，任务起了服务器却没人接。
  backgroundLimitMinutes Int @default(30)

  // ── 合并 ──────────────────────────────────────────────────────────────

  /// 自动合并。**默认关**。
  ///
  /// 开着时也只对本票开的 PR 生效，且要满足：`ready`、批准覆盖 head、
  /// 增删合计小于行数阈值。推新版本前先撤销自动合并。
  autoMerge Boolean @default(false)

  /// 自动合并的行数上限（增 + 删）。
  autoMergeMaxLines Int @default(200)

  // ── 投递 ──────────────────────────────────────────────────────────────

  /// 投递连续失败几次转 `stalled`
  deliveryMaxAttempts Int @default(3)

  /// 投递重试的封顶间隔（秒）。退避 2s → 4s → … → 这个值
  deliveryRetryCeilingSeconds Int @default(60)

  updatedAt String

  @@map("setting")
}
